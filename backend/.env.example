# ─── Required ────────────────────────────────────────────────────────────────

# Your OpenAI API key — used for both Whisper and GPT
OPENAI_API_KEY=sk-your-openai-key-here

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/meeting_ai

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-this-with-a-secure-random-32-char-string

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000

# ─── Optional ────────────────────────────────────────────────────────────────

# Clerk authentication (alternative to JWT)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Email notifications via SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# Whisper model size: tiny | base | small | medium | large
# Default is "base" — good balance of speed and accuracy
WHISPER_MODEL_SIZE=base
